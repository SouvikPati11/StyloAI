# StyloAI backend — example environment. Copy to .env and fill locally.
# NEVER commit a real .env. Full reference: ../docs/ENVIRONMENT.md

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3000/admin

# Data
DATABASE_URL=postgresql://stylo:stylo@localhost:5432/stylo
REDIS_URL=redis://localhost:6379

# Auth (backend session JWTs)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Firebase (verify ID tokens + send FCM) — provide JSON via secret in prod
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gemini (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-preview-image-generation
GEMINI_TIMEOUT_MS=60000

# AWS / storage (prefer IAM role in prod over static keys)
AWS_REGION=ap-south-1
S3_BUCKET=stylo-media
S3_UPLOAD_URL_TTL=300
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# Google Play (purchase verification)
PLAY_PACKAGE_NAME=app.stylo
PLAY_SERVICE_ACCOUNT_JSON=

# Misc
CORS_ALLOWED_ORIGINS=http://localhost:3000

# First admin (one-time seed, then rotate)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
