<?xml version="1.0" encoding="utf-8"?>
<!--
  StyloAI Android network security.

  Production is HTTPS-only. The app talks exclusively to
  https://api.souvikpati.in (Nginx TLS reverse proxy → 127.0.0.1:3000 → NestJS).
  Cleartext HTTP is blocked app-wide, and there are no per-host cleartext
  exceptions: the previous temporary exception for the raw EC2 IP has been
  removed now that the permanent HTTPS domain is in place.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
